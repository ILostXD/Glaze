CREATE TABLE play_event (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    account_key TEXT NOT NULL,
    track_id TEXT NOT NULL,
    title TEXT NOT NULL,
    artist_id TEXT,
    artist TEXT NOT NULL,
    album_id TEXT,
    album TEXT NOT NULL,
    genre TEXT,
    timestamp_ms INTEGER NOT NULL,
    listened_ms INTEGER NOT NULL,
    skipped INTEGER NOT NULL
);

CREATE INDEX play_event_account_time ON play_event(account_key, timestamp_ms DESC);

CREATE TABLE scrobble_outbox (
    account_key TEXT NOT NULL,
    track_id TEXT NOT NULL,
    timestamp_ms INTEGER NOT NULL,
    PRIMARY KEY (account_key, track_id, timestamp_ms)
);

queueScrobble:
INSERT OR IGNORE INTO scrobble_outbox VALUES (?, ?, ?);

pendingScrobbles:
SELECT track_id, timestamp_ms FROM scrobble_outbox
WHERE account_key = ? ORDER BY timestamp_ms;

acknowledgeScrobble:
DELETE FROM scrobble_outbox WHERE account_key = ? AND track_id = ? AND timestamp_ms = ?;

insertEvent:
INSERT INTO play_event (
    account_key, track_id, title, artist_id, artist, album_id, album,
    genre, timestamp_ms, listened_ms, skipped
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

recentTrackIds:
SELECT track_id FROM play_event
WHERE account_key = ?
GROUP BY track_id
ORDER BY MAX(timestamp_ms) DESC
LIMIT ?;

totalListenMs:
SELECT COALESCE(SUM(listened_ms), 0) FROM play_event
WHERE account_key = ? AND timestamp_ms >= ?;

topTrackIds:
SELECT track_id FROM play_event
WHERE account_key = ? AND timestamp_ms >= ? AND skipped = 0
GROUP BY track_id
ORDER BY COUNT(*) DESC, MAX(timestamp_ms) DESC
LIMIT ?;
